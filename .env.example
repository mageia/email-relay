# =========================================================
# email-relay unified environment template
# 复制为仓库根目录 .env 后可用于部署
# 如果你愿意，也可以把对应变量拆到 apps/server/.env、
# apps/web/.env、packages/infra/.env 中。
# =========================================================

# -------------------------
# Cloudflare deployment
# -------------------------
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# -------------------------
# Alchemy secret encryption
# 用于 Alchemy 序列化 secret bindings
# -------------------------
ALCHEMY_PASSWORD=replace-with-a-strong-alchemy-password

# -------------------------
# Web / Server public URLs
# 本地开发可先用 localhost
# 部署后改成实际 workers.dev / 自定义域名
# -------------------------
VITE_SERVER_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# -------------------------
# Admin auth
# -------------------------
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-admin-password
BETTER_AUTH_SECRET=replace-with-a-long-random-auth-secret

# -------------------------
# Internal credential encryption
# 建议 32 字节以上随机字符串
# -------------------------
MAILBOX_CREDENTIALS_SECRET=replace-with-32-byte-secret
MAILBOX_OAUTH_STATE_SECRET=replace-with-oauth-state-secret

# -------------------------
# Google / Gmail OAuth
# 如果暂时不打通 Gmail，可先填 dummy 值以便部署成功
# 真正接入时请替换成真实配置
# -------------------------
GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_OAUTH_REDIRECT_URL=https://your-server-domain/oauth/gmail/callback
GOOGLE_GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/your-gmail-topic
GOOGLE_GMAIL_PUSH_TOKEN=replace-with-gmail-push-token

# -------------------------
# Microsoft / Outlook OAuth
# 如果暂时不打通 Outlook，可先填 dummy 值以便部署成功
# 真正接入时请替换成真实配置
# -------------------------
MICROSOFT_CLIENT_ID=dummy-microsoft-client-id
MICROSOFT_CLIENT_SECRET=dummy-microsoft-client-secret
MICROSOFT_OAUTH_REDIRECT_URL=https://your-server-domain/oauth/outlook/callback
MICROSOFT_NOTIFICATION_SECRET=replace-with-microsoft-notification-secret
