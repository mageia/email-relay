{
  "name": "email-relay",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run --config packages/api/vitest.config.ts",
    "test:web": "vitest run --config apps/web/vitest.config.ts",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @email-relay/db db:push",
    "db:generate": "turbo -F @email-relay/db db:generate",
    "deploy": "turbo -F @email-relay/infra deploy",
    "destroy": "turbo -F @email-relay/infra destroy"
  },
  "dependencies": {
    "@email-relay/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@email-relay/config": "workspace:*",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "catalog:",
    "jsdom": "^26.1.0",
    "turbo": "^2.8.12",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.0"
}
